{
  "name": "Tradepsy — trading journal",
  "short_name": "Tradepsy",
  "description": "A private trading journal: trades, routines, reports, contracts and capital, stored on this device.",
  "start_url": "./tradepsy.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
